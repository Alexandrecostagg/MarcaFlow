{
  "name": "marcaflow",
  "version": "2.0.0",
  "description": "Ferramenta completa para gestão de marcas no INPI",
  "main": "public/main.js",
  "scripts": {
    "test": "node tests/run.js",
    "test:watch": "node tests/run.js --watch",
    "test:ci": "node tests/run.js --ci",
    "lint": "eslint public/**/*.js",
    "build": "echo 'Build complete'",
    "dev": "npx serve public -l 3000",
