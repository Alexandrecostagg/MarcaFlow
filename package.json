    "deploy:cloudflare": "wrangler pages deploy public/",
    "deploy:firebase": "firebase deploy",
    "backup": "node scripts/backup.js"
  },
  "keywords": [
    "marca",
    "inpi",
    "propriedade-intelectual",
    "gestao",
    "automacao"
  ],
  "author": "MarcaFlow Team",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.50.0"
  }
}
