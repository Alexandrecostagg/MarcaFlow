rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Workspace isolado por usuário (SaaS): cada usuário só acessa o próprio.
    match /users/{userId}/workspaces/{workspaceId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Coleção legada de workspaces compartilhados: mantida apenas para
    // compatibilidade, restrita ao dono do workspace (campo ownedBy).
    match /workspaces/{workspaceId} {
      allow read, update: if request.auth != null
                          && request.auth.uid == resource.data.ownedBy;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownedBy;
      allow delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.userId
                      || request.auth.uid == "principal");
      allow write: if request.auth != null
                   && request.auth.uid == request.resource.data.userId;
    }

    match /users/{userId}/settings/{settingId} {
      allow read, write: if request.auth != null
                         && (request.auth.uid == userId
                             || request.auth.uid == "principal");
    }
  }
}
